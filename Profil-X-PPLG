        .profile-card {
            border: 1px solid #b0c4de;
            margin-bottom: 25px;
            background: #fff;
        }

        .profile-header {
            background-color: #f0f4f8;
            padding: 8px 12px;
            font-size: 13px;
            font-weight: bold;
            border-bottom: 1px solid #b0c4de;
        }

        .profile-body {
            display: flex;
            padding: 15px;
        }

        .profile-left {
            width: 35%;
            text-align: center;
            border-right: 1px solid #b0c4de;
            padding-right: 15px;
            box-sizing: border-box;
        }

        .foto-box {
            width: 130px;
            height: 160px;
            background-color: #dcdcdc;
            border: 1px solid #999;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            color: #555;
            font-size: 12px;
        }

        .audio-section {
            font-size: 11px;
            text-align: left;
            margin-top: 10px;
        }

        .audio-section audio {
            width: 100%;
            margin-top: 5px;
        }

        .profile-right {
            width: 65%;
            padding-left: 15px;
            font-size: 13px;
            box-sizing: border-box;
        }

        .profile-right ul {
            padding-left: 15px;
            margin: 0 0 15px;
        }

        .profile-right li {
            margin-bottom: 6px;
        }

        .link-riwayat {
            font-size: 12px;
            font-weight: bold;
            color: #333;
            text-decoration: none;
            display: inline-block;
            margin-top: 5px;
        }

        .link-riwayat:hover {
            color: #0066cc;
        }

        details {
            font-size: 12px;
            margin-top: 12px;
        }

        summary {
            cursor: pointer;
            font-weight: bold;
        }

        .back-to-top {
            text-align: right;
            font-size: 12px;
            margin: 5px 10px 10px 0;
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

